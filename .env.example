# Every value here is optional. With an empty .env the stack boots in mock mode,
# `make test` passes offline, and no network call is ever made.

ENV=development
ROLE=api
PROVIDER_MODE=mock          # mock | real
LOG_LEVEL=info

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,chrome-extension://*

# Storage backend, independent of PROVIDER_MODE. "postgres" with PROVIDER_MODE=mock
# is the demo configuration: real persistence, no API keys, no network.
REPO_BACKEND=auto
DATABASE_URL=postgresql+psycopg://verifier:verifier@localhost:5432/verifier
REDIS_URL=redis://localhost:6379/0

# --- Vendors. Blank => that provider is unavailable and PROVIDER_MODE=real fails loudly. ---
VOYAGE_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

EMBEDDINGS_MODEL=voyage-law-2
SUMMARISER_MODEL=anthropic/claude-haiku-4.5
JUDGE_PROVIDER=openrouter    # openrouter | anthropic
JUDGE_MODEL=anthropic/claude-opus-5

# L1a's citation finder. Runs on whichever key you already have; the model id is the
# bare first-party one either way and the OpenRouter path namespaces it for you.
EXTRACTOR_PROVIDER=openrouter   # openrouter | anthropic
EXTRACTOR_MODEL=claude-haiku-4-5
#EXTRACTOR_MODE=auto          # auto follows PROVIDER_MODE | mock | real
#EXTRACTOR_TIMEOUT_S=15

# --- Thresholds. Seeds, not measurements. Calibrate per model; see docs/03-findings.md. ---
# L1a: the FAIL is a count (no authority anywhere), so it is not a threshold. The
# per-assertion finding is a judgement over prose, so it is: warn | info.
L1A_ENABLED=true
L1A_UNCITED_SEVERITY=warn
L1A_MIN_ASSERTIONS_FOR_FAIL=1

# LEFT COMMENTED ON PURPOSE. `make env` copies this file to .env, and an uncommented
# value here OVERRIDES the measured default in settings.py -- which is how this file
# came to ship L4_FAIL_BELOW=0.50 / L4_PASS_AT=0.70 long after Part 4 measured those
# seeds failing 3 of 5 CORRECT answers. Every one of these is keyed to
# EMBEDDINGS_MODEL; uncomment only to pin a value you have calibrated yourself.
#L1_QUOTE_FAIL_BELOW=75
#L1_QUOTE_PASS_AT=90
#L3_MARGIN_FAIL_AT_OR_BELOW=0.02
#L3_MARGIN_PASS_ABOVE=0.08
#L3_ABSOLUTE_FLOOR=0.35
#L4_FAIL_BELOW=0.40
#L4_PASS_AT=0.45

# Which text L3 embeds: none | heading | summary_heading. NOT a threshold -- it selects
# the text, and the thresholds above are calibrated against "heading". The summary
# variant is the one that failed correct legal work; see docs/03-findings.md F14.
#L3_CONTEXTUAL_PREFIX=heading

# --- Politeness. We are scraping a public court website; do not remove. ---
SOURCE_MAX_CONCURRENCY=2
SOURCE_MIN_INTERVAL_MS=250
SOURCE_USER_AGENT=sal-verifier/0.1 (SMU LIT 2026 research prototype)
